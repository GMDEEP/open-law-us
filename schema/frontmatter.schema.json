{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GMDEEP/open-law-us/schema/frontmatter.schema.json",
  "title": "open-law-us document frontmatter",
  "type": "object",
  "required": ["id", "jurisdiction", "type", "citation", "heading", "source_url", "source_name", "official", "retrieved_at", "content_sha256", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z]{2}(-[a-z]+)?/[a-z-]+/[A-Za-z0-9._-]+$"},
    "jurisdiction": {"type": "string", "pattern": "^[a-z]{2}$"},
    "type": {"enum": ["statute", "rule", "opinion"]},
    "citation": {"type": "string", "minLength": 3},
    "heading": {"type": "string"},
    "section": {"type": "string"},
    "title_num": {"type": "string"},
    "title_name": {"type": "string"},
    "chapter": {"type": "string"},
    "chapter_name": {"type": "string"},
    "edition": {"type": "string"},
    "rule_set": {"type": "string"},
    "history": {"type": "string"},
    "source_url": {"type": "string", "pattern": "^https://"},
    "source_name": {"type": "string"},
    "official": {"const": false},
    "retrieved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["active", "repealed", "renumbered", "reserved", "transferred"]},
    "court_id": {"type": "string"},
    "court_name": {"type": "string"},
    "case_name": {"type": "string"},
    "docket": {"type": "string"},
    "date_filed": {"type": "string"},
    "cl_cluster_id": {"type": "integer"},
    "precedential_status": {"type": "string"},
    "topic_tags": {"type": "array", "items": {"type": "string"}},
    "cites_statutes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
